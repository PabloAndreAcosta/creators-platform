# Sandlådan — läses av `next dev` och har företräde framför .env.local.
#
# Varför den här filen: Next.js laddar .env.development.local FÖRE .env.local i
# utvecklingsläge. Din .env.local pekar på produktionsdatabasen, så utan den här
# filen skriver lokal utveckling till skarp data. Nu går allt till Docker i
# stället, och .env.local ligger kvar orörd som referens.
#
# Gitignorerad via `.env*.local`.

# ---- Lokal Supabase (Docker) ------------------------------------------------
# Hämta de två nycklarna med `supabase status` efter `supabase start`.
# De är Supabases delade standardnycklar för lokal utveckling — identiska för
# alla och inga hemligheter — men står som platshållare här ändå, så att en
# exempelfil aldrig innehåller något som ser ut som en nyckel.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=      # publishable-nyckeln från `supabase status`
SUPABASE_SERVICE_ROLE_KEY=          # secret-nyckeln från `supabase status`

NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Stripe TESTLÄGE --------------------------------------------------------
# Fyll i från https://dashboard.stripe.com/test/apikeys
# Måste börja med sk_test_ / pk_test_ — annars rör sandlådan riktiga pengar.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Skrivs ut av `npm run stripe:listen` när den startar (whsec_…)
STRIPE_WEBHOOK_SECRET=

# Fylls i av `node scripts/seed-stripe-test.mjs`
STRIPE_PUBLIK_GULD_PRICE_ID=
STRIPE_PUBLIK_PREMIUM_PRICE_ID=
STRIPE_KREATOR_GULD_PRICE_ID=
STRIPE_KREATOR_PREMIUM_PRICE_ID=
STRIPE_UPPLEVELSE_GULD_PRICE_ID=
STRIPE_UPPLEVELSE_PREMIUM_PRICE_ID=

# ---- Övrigt -----------------------------------------------------------------
NEXT_PUBLIC_BETA_MODE=true
USHA_LEGAL_NAME=Usha AB
USHA_ORG_NUMBER=5594018326
